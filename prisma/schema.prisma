generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  role     Role
  ventas   Venta[]
}

model Venta {
  id             Int      @id @default(autoincrement())
  user           User     @relation(fields: [userId], references: [id])
  userId         Int
  medicamentoId  String?
  presentacion   String
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([medicamentoId])
}

model Stock {
  id            Int    @id @default(autoincrement())
  medicamentoId String
  presentacion  String
  unidades      Int

  @@unique([medicamentoId, presentacion])
}

enum Role {
  ADMIN
  USER
}
